# ============================================
# ENVIRONNEMENT
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
API_BASE_URL=/api

# ============================================
# BASE DE DONNÉES
# ============================================
MONGODB_URI=mongodb://localhost:27017/sofia_smart_solutions
MONGODB_TEST_URI=mongodb://localhost:27017/sofia_test

# ============================================
# SÉCURITÉ
# ============================================
JWT_SECRET=votre_super_secret_jwt_très_long_et_complexe_changez_moi
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ============================================
# UPLOAD & FICHIERS
# ============================================
CLOUDINARY_CLOUD_NAME=votre_cloud
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
BACKUP_DIR=./backups
MAX_BACKUPS=30

# ============================================
# EMAIL
# ============================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=votre_user_mailtrap
SMTP_PASS=votre_pass_mailtrap
EMAIL_FROM=noreply@sofiass.com
ADMIN_EMAIL=admin@sofiass.com

# ============================================
# PAIEMENT
# ============================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_xxx

# ============================================
# FRONTEND & CORS
# ============================================
FRONTEND_URL=http://localhost:5173
BACKOFFICE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# APPLICATION
# ============================================
APP_NAME=Sofia Smart Solutions
APP_VERSION=1.0.0